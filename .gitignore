# ---------------------------------------------------------------------------
# Sales Data Warehouse
# ---------------------------------------------------------------------------
# Rule of thumb: this repo contains SCHEMA and LOGIC, never DATA or SECRETS.
# Everything a reviewer needs must be reproducible by running the .sql files.
# ---------------------------------------------------------------------------

# --- Secrets & local connection config -------------------------------------
# A leaked connection string is the fastest way to fail a portfolio review.
.env
.env.*
!.env.example
.pgpass
*.pgpass
.pg_service.conf
secrets/
*.key
*.pem
*.crt

# --- Database artefacts -----------------------------------------------------
# pg_dump / pg_restore output and any local cluster mounted into the repo.
*.dump
*.backup
*.bak
*.sql.gz
*.tar.gz
pgdata/
pg_data/
postgres-data/
docker-volumes/
.psql_history
.psqlrc.local

# --- Data extracts ----------------------------------------------------------
# Sample data is GENERATED by sample_data.sql, so raw/extracted files are
# never committed. The negation keeps intentionally-checked-in fixtures.
data/raw/
data/staging/
data/output/
exports/
*.csv
*.tsv
*.parquet
*.avro
*.xlsx
!seed/**/*.csv
!fixtures/**/*.csv

# --- Query tuning output ----------------------------------------------------
explain/
*.explain
*.plan
*.sqlplan

# --- Python tooling (optional loader / orchestration) -----------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- dbt (if the transform layer is later ported) ---------------------------
target/
dbt_packages/
dbt_modules/
logs/
profiles.yml

# --- Node tooling (optional dashboard) --------------------------------------
node_modules/
dist/
build/
.next/

# --- Agent / tooling local state --------------------------------------------
# Machine-local permission grants — never shared.
.claude/settings.local.json

# --- Editors & OS -----------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & temp ------------------------------------------------------------
*.log
tmp/
temp/
.cache/
